{
  "name": "adlc-cli",
  "version": "2.10.0",
  "description": "Dual-mode CLI for coding agents: skill management + headless task execution + the workflow engine (dual-executor: skills in-session, CLI headless \u2014 ADR-395).",
  "type": "module",
  "bin": {
    "adlc-cli": "bin/adlc-cli.mjs",
    "adlc-skills-cli": "bin/adlc-skills-cli.mjs"
  },
  "scripts": {
    "test": "node --test && node tests/e2e-node-gate.mjs --skip-agent && node tests/e2e-cross-session.mjs",
    "test:evals": "node --test evals/opencode-session-end/tests/test_check_session_end.mjs",
    "test:all": "npm test && npm run test:evals",
    "prepublishOnly": "npm test",
    "format:check": "node bin/adlc-cli.mjs format check docs README.md --recursive",
    "format:fix": "node bin/adlc-cli.mjs format fix docs README.md --recursive --write"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "src/",
    "shim/",
    "workflows/"
  ],
  "keywords": [
    "ai",
    "agent",
    "cli",
    "skills",
    "opencode",
    "claude",
    "cursor",
    "codex",
    "copilot",
    "gemini",
    "goose"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tikalk/adlc-cli.git"
  },
  "homepage": "https://github.com/tikalk/adlc-cli#readme",
  "publishConfig": {
    "provenance": true
  }
}
