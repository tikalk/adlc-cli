    "type": "git",
    "url": "git+https://github.com/tikalk/adlc-cli.git"
  },
  "bugs": {
    "url": "https://github.com/tikalk/adlc-cli/issues"
  },
  "keywords": [
    "skills",
    "commands",
    "agent",
    "cli",
    "adlc",
    "slash-commands",
    "events",
    "hooks",
    "opencode",
